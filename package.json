{
  "name": "edument",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=22 <25"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web \"pnpm --filter @edument/api dev\" \"pnpm --filter @edument/web dev\"",
    "build": "pnpm --filter @edument/api build && pnpm --filter @edument/web build",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "eslint apps packages/shared scripts tests && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run --configLoader runner && pnpm contract:test",
    "test:e2e": "playwright test",
    "test:integration": "tsx scripts/integration.ts",
    "db:generate": "prisma generate --schema apps/api/prisma/schema.prisma",
    "db:migrate": "prisma migrate deploy --schema apps/api/prisma/schema.prisma",
    "db:studio": "prisma studio --schema apps/api/prisma/schema.prisma",
    "bootstrap:admin": "tsx scripts/admin.ts",
    "infra:up": "node scripts/infra.mjs up",
    "infra:down": "node scripts/infra.mjs down",
    "chain:single:up": "node scripts/infra.mjs single up",
    "chain:single:down": "node scripts/infra.mjs single down",
    "chain:multi:up": "node scripts/infra.mjs multi up",
    "chain:multi:down": "node scripts/infra.mjs multi down",
    "chain:status": "tsx scripts/chain-status.ts",
    "chain:reset-local": "node scripts/infra.mjs reset",
    "chain:generate": "tsx scripts/genesis.ts",
    "contract:compile": "pnpm --filter @edument/contracts compile",
    "contract:test": "pnpm --filter @edument/contracts test",
    "contract:deploy": "tsx scripts/deploy.ts",
    "integrity:check": "tsx scripts/integrity.ts",
    "setup:local": "node scripts/setup.mjs",
    "demo:generate": "tsx packages/demo-data/cli.ts generate",
    "demo:import": "tsx packages/demo-data/cli.ts import",
    "demo:remove": "tsx packages/demo-data/cli.ts remove",
    "research:generate": "node scripts/python.mjs services/matcher/research.py generate",
    "research:run": "tsx scripts/research.ts",
    "research:cleanup": "node scripts/python.mjs services/matcher/research.py cleanup",
    "matcher:train": "node scripts/python.mjs services/matcher/train.py",
    "matcher:test": "node scripts/python.mjs -m pytest services/matcher/tests -q"
  },
  "dependencies": {
    "@prisma/client": "6.19.2",
    "argon2": "^0.44.0",
    "dotenv": "^17.2.3",
    "ethers": "^6.16.0",
    "zod": "^3.25.76",
    "canonicalize": "^2.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "eslint": "^9.39.1",
    "typescript-eslint": "^8.50.0",
    "prettier": "^3.7.4",
    "concurrently": "^9.2.1",
    "prisma": "6.19.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4",
    "@types/node": "^22.19.3",
    "@playwright/test": "^1.57.0"
  },
  "description": "EduMent: öğrenci gelişimi, kurum onaylı başarı kayıtları ve açıklanabilir mentor eşleştirmesi.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/atillahan00/edument.git"
  },
  "bugs": {
    "url": "https://github.com/atillahan00/edument/issues"
  }
}
